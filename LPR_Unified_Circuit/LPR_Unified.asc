TEXT 64 24 Left 4 ;LPR | ONE CONNECTED CIRCUIT
TEXT 64 88 Left 2 ;CASE: nominal_healthy | every shared node is joined by drawn wire | dots are junctions; plain crossings are separate nets
TEXT 64 144 Left 2 !.param RU=10k RP=100k CDL=100u RCOUNTER=10k
TEXT 64 184 Left 2 !.param RF=1Meg GAIN=1 OFFSET=0 NOISE=0 REVERSEGAIN=1 UNSTABLE=0
TEXT 64 224 Left 2 !.param TSTOP=676.00002
TEXT 1600 144 Left 2 ;Right-click any part or parameter to edit. SELECT_CASE.command loads 16 test presets.
TEXT 1600 184 Left 2 ;OFFSET / RF and NOISE / RF are the equivalent current error in amperes.
TEXT 64 336 Left 2 ;5 V / MIDPOINT
TEXT 720 336 Left 2 ;TIA / WORKING ELECTRODE
TEXT 1376 336 Left 2 ;SWITCHED Rp-Cdl CELL + 10k REFERENCE
TEXT 2544 336 Left 2 ;REFERENCE / CE CONTROL
TEXT 64 1280 Left 2 ;MEASUREMENT: TIA -> GAIN / OFFSET / NOISE -> FILTER -> SAMPLE / HOLD -> I_MEAS
TEXT 64 2048 Left 2 ;PROGRAMMED EXCITATION AND SWITCH CONTROL | editable PWL files in stimuli/
TEXT 64 2592 Left 2 !.include p1_opamp.lib
TEXT 64 2632 Left 2 !.include behavioral_blocks.lib
TEXT 64 2672 Left 2 !.model SWITCH_PATH SW(Ron=1m Roff=1e15 Vt=.5 Vh=.05)
TEXT 64 2712 Left 2 !.model SAMPLE_SWITCH SW(Ron=100 Roff=1e15 Vt=.5 Vh=0)
TEXT 64 2752 Left 2 !.options plotwinsize=0 reltol=1e-5 abstol=1p vntol=10n
TEXT 64 2792 Left 2 !.tran 0 {TSTOP} 0 25m
TEXT 64 2832 Left 2 !.include saved_channels.inc
