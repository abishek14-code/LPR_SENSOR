TEXT 40 1632 Left 2 ;i_true and i_meas: voltage helper numeric values represent amperes. Matching net labels are electrically connected.
TEXT 40 1712 Left 1 !* P1_OP model embedded below\n.param RU=10k RP=100k CDL=100u AMP=10m RF=1Meg RADC=1k CADC=1u\n.param GAINSTEP=0 OFFSET=0 NOISE=0 SWFAULT=0\n.model P1_SWITCH SW(Ron=1 Roff=1T Vt=0.5 Vh=0.05)\n.func relay_fn(t) {if(SWFAULT>0,if(t<10,1,if(t<10.02,0,1)),1)}\n.func condition_fn(t) {V(vmid)+(1+GAINSTEP*if(t>8,1,0))*(V(tia)-V(vmid))+OFFSET*if(t>8,1,0)+NOISE*V(nunit)}\n.options plotwinsize=0 reltol=1e-5 abstol=1p vntol=10n\n.save V(req) V(actual) V(i_true) V(i_meas) V(vmid) V(tia) V(adc) V(relay) V(eta) V(ce) V(re) V(we)\n.tran 0 56 0 1m\n.meas tran epos AVG V(actual) FROM=13 TO=14
TEXT 872 1712 Left 1 !.meas tran eneg AVG V(actual) FROM=31 TO=32\n.meas tran ipos_true AVG V(i_true) FROM=13 TO=14\n.meas tran ineg_true AVG V(i_true) FROM=31 TO=32\n.meas tran ipos_meas AVG V(i_meas) FROM=13 TO=14\n.meas tran ineg_meas AVG V(i_meas) FROM=31 TO=32\n.meas tran rdc_true PARAM (epos-eneg)/(ipos_true-ineg_true)\n.meas tran rdc_meas PARAM (epos-eneg)/(ipos_meas-ineg_meas)\n.meas tran rp_meas PARAM rdc_meas-RU\n.meas tran vmid_dc AVG V(vmid) FROM=1 TO=1.5\n.meas tran max_adc MAX V(adc)
TEXT 1704 1712 Left 1 !.meas tran min_adc MIN V(adc)
TEXT 40 2112 Left 1 !.subckt P1_OP inp inn vp vn out params: A0=100k GBW=1Meg VOS=0 RIN=1T IB=0 ROUT=20\nRdiff inp inn {RIN}\nIbp inp vn {IB}\nIbn inn vn {IB}\nBdrive drive 0 V=limit((V(vp)+V(vn))/2+A0*(V(inp,inn)+VOS),V(vn)+0.1,V(vp)-0.1)\nRdom drive pole 1k\nCdom pole 0 {A0/(2*pi*GBW*1k)}\nEout ideal 0 pole 0 1\nRout ideal out {ROUT}\n.ends P1_OP
